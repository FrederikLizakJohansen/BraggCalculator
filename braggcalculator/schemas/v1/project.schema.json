{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braggcalculator.org/schemas/v1/project.schema.json",
  "title": "BraggCalculator project v1",
  "type": "object",
  "required": ["schema", "project_id", "title", "dataset", "models", "policy", "runs", "audit"],
  "properties": {
    "schema": {"const": "braggcalculator.project/v1"},
    "project_id": {"type": "string"},
    "title": {"type": "string"},
    "dataset": {"type": "object"},
    "models": {"type": "array", "minItems": 1},
    "policy": {"type": "object"},
    "runs": {"type": "array"},
    "audit": {"type": "array"}
  },
  "additionalProperties": true
}
